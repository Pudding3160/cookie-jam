[sub_resource type="GDScript" id="GDScript_r5n4g"]
resource_name = "animate"
script/source = "extends Sprite2D


func _ready() -> void:
	var pos = position
	var tween = create_tween()
	tween.set_parallel(true).set_ease(Tween.EASE_OUT_IN)
	tween.tween_property(self, \"rotation\", 1.5, .5)
	tween.tween_property(self, \"position\", pos + Vector2(0, -800), .5)
"

