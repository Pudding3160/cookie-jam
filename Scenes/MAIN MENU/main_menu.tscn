base_font = ExtResource("1_0ki4d")

[sub_resource type="GDScript" id="GDScript_0ki4d"]
resource_name = "start_game"
script/source = "extends Button

@export var next_scene: PackedScene
@onready var root := $\"../../../\"

func _on_pressed() -> void:
	var result = await SceneTransition.fade_in();
	if result:
		var scene := next_scene.instantiate()
		get_tree().root.add_child(scene);
		SceneTransition.fade_out(false);
		root.queue_free()
"

[sub_resource type="GDScript" id="GDScript_r5n4g"]
resource_name = "quit_game"
script/source = "extends Button

func _on_pressed() -> void:
	get_tree().quit(0);
"

