[gd_scene format=3 uid="uid://dckax87qb371f"]

[ext_resource type="Texture2D" uid="uid://c50i8i8yijuwh" path="res://Sprites/HonsSprites/bg.png" id="1_crfs3"]

[sub_resource type="GDScript" id="GDScript_crfs3"]
resource_name = "control"
script/source = "extends Node

@onready var texture := $CanvasLayer/CenterContainer/TextureRect
@export var trans_time := .6

func _ready() -> void:
	texture.modulate.a = 0;

func fade_in(is_async := true) -> bool:
	var tween = create_tween()
	tween.tween_property(texture, \"modulate\", Color(0, 0, 0, 1), trans_time);
	if is_async: await tween.finished;
	return true;

func fade_out(is_async := true) -> bool:
	var tween = create_tween()
	tween.tween_property(texture, \"modulate\", Color(0, 0, 0, 0), trans_time);
	if is_async: await tween.finished;
	return true;
"

[node name="SceneTransition" type="Node" unique_id=509731133]
script = SubResource("GDScript_crfs3")

